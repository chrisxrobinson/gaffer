{
  "name": "pi-gaffer",
  "version": "0.1.0",
  "private": true,
  "description": "Gaffer: a Fantasy Premier League advisor as a Pi package",
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/gaffer-core/index.ts",
      "./extensions/gaffer-sandbox/index.ts",
      "./extensions/gaffer-data/index.ts",
      "./extensions/gaffer-recommend/index.ts",
      "./extensions/gaffer-budget/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts/*.md"],
    "themes": ["./themes/*.json"]
  },
  "scripts": {
    "test": "vitest run",
    "export-schema": "node scripts/export-schema.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "typebox": "1.3.27",
    "vitest": "5.0.2"
  }
}
