#!/bin/sh
# Pi as Gaffer (ARCHITECTURE §1.5). Runs inside tmux; --continue resumes the latest session after a restart.
set -eu
cd /work   # same path as the sandbox working dir; empty and read-only here
# --tui-mode fullscreen: Pi keeps the transcript and scrolls it itself (wheel, PageUp/PageDown, Home/End).
# In regular mode Pi relies on the terminal's scrollback, and tmux doesn't pass every line that scrolls
# off to the browser: the top of a result taller than the window (a recommendation) could not be reached.
set -- --session-dir /sessions --no-context-files --continue --tui-mode fullscreen \
  --tools read,write,edit,bash,fpl_snapshot,submit_recommendation,set_preferences
[ -n "${GAFFER_PROVIDER:-}" ] && set -- "$@" --provider "$GAFFER_PROVIDER"
[ -n "${GAFFER_MODEL:-}" ] && set -- "$@" --model "$GAFFER_MODEL"
[ -n "${GAFFER_THINKING:-}" ] && set -- "$@" --thinking "$GAFFER_THINKING"
exec pi "$@"
